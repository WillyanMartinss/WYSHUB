<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WYSHUB</AssemblyName>
    <RootNamespace>WYSHUB</RootNamespace>
    <ApplicationIcon>icons\Light.ico</ApplicationIcon>

    <!-- Publicação self-contained: gera um .exe único que roda em qualquer Windows,
         sem precisar instalar o .NET Runtime na máquina do cliente -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icons\Light.ico" />
    <Resource Include="icons\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\scripts\**\*">
      <Link>scripts\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <EmbeddedResource Include="..\scripts\setup-wizard.ps1">
      <Link>scripts\setup-wizard.ps1</Link>
    </EmbeddedResource>

    <Content Include="..\requirements.txt">
      <Link>requirements.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Biblioteca responsável por ler temperatura, uso de CPU, RAM, SSD, GPU, fans, voltagem etc -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <!-- Cliente HTTP para chamar a API do Resend (envio de e-mail com o relatório) -->
    <PackageReference Include="System.Net.Http.Json" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <!-- QuestPDF removed: PDF generation disabled -->
  </ItemGroup>

</Project>
