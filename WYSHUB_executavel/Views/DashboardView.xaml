<UserControl x:Class="SystemWM.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Cabeçalho -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextoPrimario}"/>
                <TextBlock Text="Visão geral do sistema em tempo real" Style="{StaticResource LabelSecundario}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnAtualizar" Content="⟳ Atualizar" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Click="BtnAtualizar_Click"/>
            </StackPanel>
        </Grid>


        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PainelStatus" Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,20,0,8">
                    <TextBlock Text="Cards no relatório: " Foreground="{StaticResource TextoSecundario}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtCardsSelecionados" Text="0" Foreground="#4ADE80" FontWeight="Bold"/>
                </StackPanel>

                <TextBlock x:Name="TxtCarregando" Text="Coletando dados do hardware..." Foreground="{StaticResource TextoSecundario}" Margin="0,0,0,0"/>

                <Grid x:Name="GridCards" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- CPU -->
                    <Border x:Name="CpuCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,12" PreviewMouseWheel="CpuCard_PreviewMouseWheel" MouseEnter="CpuCard_MouseEnter" MouseLeave="CpuCard_MouseLeave" MouseLeftButtonDown="CpuCard_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="🔷 CPU" Style="{StaticResource TituloCard}"/>
                                    <StackPanel x:Name="IndicadorCpu" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                                        <Ellipse x:Name="CpuDot1" Width="5" Height="5" Fill="{StaticResource AzulDestaque}" Margin="0,0,4,0" Stroke="Transparent" StrokeThickness="0"/>
                                        <Ellipse x:Name="CpuDot2" Width="5" Height="5" Fill="{StaticResource BorderCard}" Margin="0,0,4,0" Stroke="Transparent" StrokeThickness="0"/>
                                        <Ellipse x:Name="CpuDot3" Width="5" Height="5" Fill="{StaticResource BorderCard}" Margin="0,0,4,0" Stroke="Transparent" StrokeThickness="0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="TxtCpuNome" Style="{StaticResource LabelSecundario}" Margin="0,4,0,10" TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="📊" Margin="0,0,8,0" Foreground="{StaticResource AzulDestaque}" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtCpuUso" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AzulDestaque}"/>
                                </StackPanel>

                                <StackPanel Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="⚙️" Margin="0,0,8,0" Foreground="{StaticResource TextoSecundario}"/>
                                        <TextBlock x:Name="TxtCpuFreq" Style="{StaticResource LabelSecundario}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="🌡️" Margin="0,0,8,0" Foreground="{StaticResource TextoSecundario}"/>
                                        <TextBlock x:Name="TxtCpuTemp" Style="{StaticResource LabelSecundario}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔊" Margin="0,0,8,0" Foreground="{StaticResource TextoSecundario}"/>
                                        <TextBlock x:Name="TxtCpuFans" Style="{StaticResource LabelSecundario}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,6">
                                    <Path x:Name="CpuRing" Stroke="{StaticResource AzulDestaque}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="84" Height="84" Stretch="None"/>
                                    <Ellipse Width="84" Height="84" Stroke="{StaticResource BorderCard}" StrokeThickness="4" Fill="Transparent"/>
                                    <TextBlock x:Name="TxtCpuRing" Text="0%" FontWeight="Bold" Foreground="{StaticResource TextoPrimario}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Path x:Name="CpuTempRing" Stroke="{StaticResource AmareloAlerta}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="64" Height="64" Stretch="None"/>
                                    <Ellipse Width="64" Height="64" Stroke="{StaticResource BorderCard}" StrokeThickness="3" Fill="Transparent"/>
                                    <TextBlock x:Name="TxtCpuTempRing" Text="0°C" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextoPrimario}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- RAM -->
                    <Border x:Name="RamCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12" MouseLeftButtonDown="CardDashboard_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="🔷 RAM" Style="{StaticResource TituloCard}"/>
                                <TextBlock x:Name="TxtRamTotal" Style="{StaticResource LabelSecundario}" Margin="0,4,0,10"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="🧠" Margin="0,0,8,0" Foreground="{StaticResource RoxoDestaque}" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtRamUso" FontSize="30" FontWeight="Bold" Foreground="{StaticResource RoxoDestaque}"/>
                                </StackPanel>

                                <StackPanel Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="📦" Margin="0,0,8,0" Foreground="{StaticResource TextoSecundario}"/>
                                        <TextBlock x:Name="TxtRamUsada" Style="{StaticResource LabelSecundario}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾" Margin="0,0,8,0" Foreground="{StaticResource TextoSecundario}"/>
                                        <TextBlock x:Name="TxtRamDisp" Style="{StaticResource LabelSecundario}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Path x:Name="RamRing" Stroke="{StaticResource RoxoDestaque}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="100" Height="100" Stretch="None"/>
                                <Ellipse Width="100" Height="100" Stroke="{StaticResource BorderCard}" StrokeThickness="4" Fill="Transparent"/>
                                <TextBlock x:Name="TxtRamRing" Text="0%" FontWeight="Bold" Foreground="{StaticResource TextoPrimario}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- SSD -->
                    <Border x:Name="DiscoCard" Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,12" PreviewMouseWheel="DiscoCard_PreviewMouseWheel" MouseEnter="DiscoCard_MouseEnter" MouseLeave="DiscoCard_MouseLeave" MouseLeftButtonDown="DiscoCard_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="🔷 Armazenamento" Style="{StaticResource TituloCard}"/>
                                    <StackPanel x:Name="IndicadorDisco" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                                        <Ellipse x:Name="DiscoDot1" Width="5" Height="5" Fill="{StaticResource AzulDestaque}" Margin="0,0,4,0" Stroke="Transparent" StrokeThickness="0"/>
                                        <Ellipse x:Name="DiscoDot2" Width="5" Height="5" Fill="{StaticResource BorderCard}" Margin="0,0,4,0" Stroke="Transparent" StrokeThickness="0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="TxtDiscoMarca" Style="{StaticResource LabelSecundario}" Margin="0,4,0,2" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtDiscoModelo" Style="{StaticResource LabelSecundario}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="💾" Margin="0,0,8,0" Foreground="{StaticResource AzulDestaque}" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtDiscoUso" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AzulDestaque}"/>
                                </StackPanel>

                                <StackPanel Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="📉" Margin="0,0,8,0" Foreground="{StaticResource TextoSecundario}"/>
                                        <TextBlock x:Name="TxtDiscoLivre" Style="{StaticResource LabelSecundario}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="🌡️" Margin="0,0,8,0" Foreground="{StaticResource TextoSecundario}"/>
                                        <TextBlock x:Name="TxtDiscoTemp" Style="{StaticResource LabelSecundario}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛡️" Margin="0,0,8,0" Foreground="{StaticResource TextoSecundario}"/>
                                        <TextBlock x:Name="TxtDiscoSaude" Style="{StaticResource LabelSecundario}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,6">
                                    <Path x:Name="DiscoRing" Stroke="{StaticResource VerdeOk}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="84" Height="84" Stretch="None"/>
                                    <Ellipse Width="84" Height="84" Stroke="{StaticResource BorderCard}" StrokeThickness="4" Fill="Transparent"/>
                                    <TextBlock x:Name="TxtDiscoRing" Text="0%" FontWeight="Bold" Foreground="{StaticResource TextoPrimario}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Path x:Name="DiscoTempRing" Stroke="{StaticResource AzulDestaque}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="64" Height="64" Stretch="None"/>
                                    <Ellipse Width="64" Height="64" Stroke="{StaticResource BorderCard}" StrokeThickness="3" Fill="Transparent"/>
                                    <TextBlock x:Name="TxtDiscoTempRing" Text="0°C" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextoPrimario}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Placa-mãe -->
                    <Border x:Name="MoboCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12" MouseLeftButtonDown="CardDashboard_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="🔷 Placa-mãe" Style="{StaticResource TituloCard}"/>
                                <TextBlock x:Name="TxtMoboNome" Style="{StaticResource LabelSecundario}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="🧩" Margin="0,0,8,0" Foreground="{StaticResource AzulDestaque}" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtMoboChipset" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextoPrimario}"/>
                                </StackPanel>
                                <StackPanel Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="📘" Margin="0,0,8,0" Foreground="{StaticResource TextoSecundario}"/>
                                        <TextBlock x:Name="TxtMoboBios" Style="{StaticResource LabelSecundario}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⏱️" Margin="0,0,8,0" Foreground="{StaticResource TextoSecundario}"/>
                                        <TextBlock x:Name="TxtMoboUptime" Style="{StaticResource LabelSecundario}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,0">
                                    <Path x:Name="MoboRing" Stroke="{StaticResource VerdeOk}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="84" Height="84" Stretch="None"/>
                                    <Ellipse Width="84" Height="84" Stroke="{StaticResource BorderCard}" StrokeThickness="4" Fill="Transparent"/>
                                    <TextBlock x:Name="TxtMoboRing" Text="OK" FontWeight="Bold" Foreground="{StaticResource TextoPrimario}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Placa de vídeo -->
                    <Border x:Name="GpuCard" Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,18" MouseLeftButtonDown="CardDashboard_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="🔷 Placa de Vídeo" Style="{StaticResource TituloCard}"/>
                                <TextBlock x:Name="TxtGpuNome" Style="{StaticResource LabelSecundario}" Margin="0,4,0,10" TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="🎮" Margin="0,0,8,0" Foreground="{StaticResource RoxoDestaque}" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtGpuUso" FontSize="30" FontWeight="Bold" Foreground="{StaticResource RoxoDestaque}"/>
                                </StackPanel>

                                <StackPanel Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="🌡️" Margin="0,0,8,0" Foreground="{StaticResource TextoSecundario}"/>
                                        <TextBlock x:Name="TxtGpuTemp" Style="{StaticResource LabelSecundario}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="🧠" Margin="0,0,8,0" Foreground="{StaticResource TextoSecundario}"/>
                                        <TextBlock x:Name="TxtGpuMem" Style="{StaticResource LabelSecundario}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔊" Margin="0,0,8,0" Foreground="{StaticResource TextoSecundario}"/>
                                        <TextBlock x:Name="TxtGpuFans" Style="{StaticResource LabelSecundario}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,6">
                                    <Path x:Name="GpuRing" Stroke="{StaticResource RoxoDestaque}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="84" Height="84" Stretch="None"/>
                                    <Ellipse Width="84" Height="84" Stroke="{StaticResource BorderCard}" StrokeThickness="4" Fill="Transparent"/>
                                    <TextBlock x:Name="TxtGpuRing" Text="0%" FontWeight="Bold" Foreground="{StaticResource TextoPrimario}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Path x:Name="GpuTempRing" Stroke="{StaticResource AmareloAlerta}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="64" Height="64" Stretch="None"/>
                                    <Ellipse Width="64" Height="64" Stroke="{StaticResource BorderCard}" StrokeThickness="3" Fill="Transparent"/>
                                    <TextBlock x:Name="TxtGpuTempRing" Text="0°C" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextoPrimario}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Sistema -->
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="🔷 Sistema" Style="{StaticResource TituloCard}"/>
                            <TextBlock x:Name="TxtSisHost" Style="{StaticResource LabelSecundario}" Margin="0,8,0,2" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtSisBios" Style="{StaticResource LabelSecundario}" Margin="0,2" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtSisUptime" Style="{StaticResource LabelSecundario}" Margin="0,2" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>


                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Visibility="{Binding Visibility, ElementName=GridCards}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtRede" Style="{StaticResource LabelSecundario}" Margin="0,0,30,0"/>
                        <TextBlock x:Name="TxtIpLocal" Style="{StaticResource LabelSecundario}" Margin="0,0,30,0"/>
                        <TextBlock x:Name="TxtIpPublica" Style="{StaticResource LabelSecundario}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
