<UserControl x:Class="SystemWM.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="HardwareAccent" Color="#3DDC84"/>
        <SolidColorBrush x:Key="HardwareCardBackground" Color="#152933"/>
        <Style x:Key="HardwareCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Background" Value="{StaticResource HardwareCardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HardwareAccent}"/>
        </Style>
        <DataTemplate x:Key="HardwareLineTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource TextoPrimario}" Margin="0,2,0,2"/>
        </DataTemplate>
        <DataTemplate x:Key="HardwareDeviceTemplate">
            <Border Background="#121528" CornerRadius="10" Padding="12" Margin="0,4,0,4">
                <StackPanel>
                    <TextBlock Text="{Binding Nome}" Foreground="{StaticResource TextoPrimario}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Detalhes}" Style="{StaticResource LabelSecundario}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="Tipo: {Binding Tipo}" Style="{StaticResource LabelSecundario}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Hardware" FontSize="28" FontWeight="Bold" Foreground="{StaticResource HardwareAccent}"/>
                <TextBlock Text="Detalhes completos dos componentes" Style="{StaticResource LabelSecundario}" Foreground="{StaticResource TextoPrimario}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⟳ Atualizar" Style="{StaticResource BotaoSecundario}" Click="BtnAtualizar_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnGerarRelatorio" Content="📧 Gerar Relatório" Style="{StaticResource BotaoPrimario}" Click="BtnGerarRelatorio_Click"/>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="TxtCarregando" Text="Coletando dados..." Foreground="{StaticResource TextoSecundario}"/>

                <Border Style="{StaticResource HardwareCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Processador (CPU)" Style="{StaticResource TituloCard}" Foreground="{StaticResource HardwareAccent}"/>
                        <ItemsControl x:Name="ListaCpu" Margin="0,10,0,0" ItemTemplate="{StaticResource HardwareLineTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HardwareCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Memória RAM" Style="{StaticResource TituloCard}" Foreground="{StaticResource HardwareAccent}"/>
                        <ItemsControl x:Name="ListaRam" Margin="0,10,0,0" ItemTemplate="{StaticResource HardwareLineTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HardwareCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Armazenamento" Style="{StaticResource TituloCard}" Foreground="{StaticResource HardwareAccent}"/>
                        <ItemsControl x:Name="ListaDiscos" Margin="0,10,0,0" ItemTemplate="{StaticResource HardwareLineTemplate}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="CardGpu" Style="{StaticResource HardwareCardStyle}" Margin="0,0,0,14" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Placa de Vídeo (GPU)" Style="{StaticResource TituloCard}" Foreground="{StaticResource HardwareAccent}"/>
                        <ItemsControl x:Name="ListaGpu" Margin="0,10,0,0" ItemTemplate="{StaticResource HardwareLineTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HardwareCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <Expander x:Name="ExpanderDispositivos" Header="Dispositivos Plug and Play" Foreground="{StaticResource HardwareAccent}" Expanded="ExpanderDispositivos_Expanded">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Clique com o botão direito em um dispositivo para abrir o Gerenciador de Dispositivos." Style="{StaticResource LabelSecundario}" Foreground="{StaticResource TextoPrimario}" TextWrapping="Wrap"/>
                                <Button Content="Abrir Gerenciador de Dispositivos" Style="{StaticResource BotaoSecundario}" Click="BtnAbrirGerenciador_Click" Margin="0,12,0,0" Width="220" HorizontalAlignment="Left"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420" Margin="0,12,0,0">
                                    <ListView x:Name="ListaDispositivos" ItemTemplate="{StaticResource HardwareDeviceTemplate}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="ContextMenu">
                                                    <Setter.Value>
                                                        <ContextMenu>
                                                            <MenuItem Header="Ir para Gerenciamento de Dispositivos" Click="MenuItemAbrirGerenciador_Click"/>
                                                        </ContextMenu>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,4,0,4"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                    </ListView>
                                </ScrollViewer>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
