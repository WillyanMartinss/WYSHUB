<UserControl x:Class="SystemWM.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="AcaoRapidaButton" TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E3A8A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#172554"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AcaoPrimariaButton" TargetType="Button" BasedOn="{StaticResource BotaoPrimario}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="Manutenção" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextoPrimario}"/>
            <TextBlock Text="Limpeza de arquivos temporários e itens do sistema" Style="{StaticResource LabelSecundario}"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Status da limpeza" Style="{StaticResource TituloCard}" Margin="0,0,0,8"/>
                        <ProgressBar x:Name="BarraProgressoLimpeza" Height="10" Minimum="0" Maximum="100" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtStatusLimpeza" Text="Aguardando início da limpeza..." Foreground="{StaticResource TextoPrimario}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtItemAtual" Text="" Style="{StaticResource LabelSecundario}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#0b1220" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="10" Margin="16,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Log em tempo real" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="TxtLogLimpeza" Text="Aguardando início da limpeza..." Foreground="#E2E8F0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Ações rápidas" Foreground="#E2E8F0" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button Grid.Row="0" Grid.Column="1" x:Name="BtnVerificarDefender" Content="🛡️ Verificar Defender" Margin="0,0,8,0" Click="BtnVerificarDefender_Click" Style="{StaticResource AcaoRapidaButton}"/>
                        <Button Grid.Row="0" Grid.Column="2" x:Name="BtnAtualizarWindows" Content="⬇️ Atualizar Windows" Margin="0,0,8,0" Click="BtnAtualizarWindows_Click" Style="{StaticResource AcaoRapidaButton}"/>
                        <Button Grid.Row="0" Grid.Column="3" x:Name="BtnSelecionarPastaBackup" Content="📁 Pasta de backup" Margin="0,0,8,0" Click="BtnSelecionarPastaBackup_Click" Style="{StaticResource AcaoRapidaButton}"/>
                        <Button Grid.Row="0" Grid.Column="4" x:Name="BtnLimpar" Content="🧹 Limpar selecionados" Margin="0,0,8,0" Click="BtnLimpar_Click" Style="{StaticResource AcaoPrimariaButton}"/>
                        <Button Grid.Row="0" Grid.Column="5" x:Name="BtnLimparPastaPersonalizada" Content="🗂️ Pasta personalizada" Margin="0,0,8,0" Click="BtnLimparPastaPersonalizada_Click" Style="{StaticResource AcaoRapidaButton}"/>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkHabilitarBackup" Content="Usar pasta de backup" Foreground="{StaticResource TextoPrimario}" VerticalAlignment="Center" Checked="ChkHabilitarBackup_Changed" Unchecked="ChkHabilitarBackup_Changed"/>
                            <TextBlock x:Name="TxtPastaBackupSelecionada" Text="Nenhuma pasta de backup selecionada" Style="{StaticResource LabelSecundario}" Margin="16,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListaLimpeza">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding CorFundo}" BorderBrush="{Binding CorBorda}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonUp="CardLimpeza_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding Selecionado, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Nome}" Foreground="{StaticResource TextoPrimario}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding NivelAlertaTexto}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding CorBorda}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Descricao}" Style="{StaticResource LabelSecundario}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding TamanhoEstimadoMB, StringFormat='~{0} MB'}" Style="{StaticResource LabelSecundario}"/>
                                                <TextBlock Text="{Binding CaminhoExibicao}" Style="{StaticResource LabelSecundario}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                <Button Content="📁 Escolher pasta" Margin="0,8,0,0" Padding="8,4" HorizontalAlignment="Left" Visibility="{Binding PodePersonalizar, Converter={StaticResource BoolToVisibilityConverter}}" Click="BtnEscolherPasta_Click" Tag="{Binding}" Style="{StaticResource BotaoPequeno}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
