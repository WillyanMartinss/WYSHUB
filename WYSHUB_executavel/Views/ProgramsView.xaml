<UserControl x:Class="SystemWM.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="Programas" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextoPrimario}"/>
            <TextBlock Text="Liste os programas instalados, filtre itens e escolha quais devem aparecer no relatório." Style="{StaticResource LabelSecundario}"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="120"/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                <Button x:Name="BtnSelecionarTodos" Content="🔹 Selecionar todos" Margin="0,0,8,8" Padding="10,6" Style="{StaticResource BotaoPequeno}" Click="BtnSelecionarTodos_Click"/>
                <Button x:Name="BtnDesmarcarTodos" Content="🔸 Desmarcar todos" Margin="0,0,8,8" Padding="10,6" Style="{StaticResource BotaoPequeno}" Click="BtnDesmarcarTodos_Click"/>
                <Button x:Name="BtnOcultarServicos" Content="🕵 Ocultar serviços" Margin="0,0,8,8" Padding="10,6" Style="{StaticResource BotaoPequeno}" Click="BtnOcultarServicos_Click"/>
                <CheckBox x:Name="ChkOcultarDrivers" Content="Ocultar drivers" Margin="0,0,8,8" VerticalAlignment="Center" Foreground="{StaticResource TextoPrimario}" Checked="ChkOcultarDrivers_Changed" Unchecked="ChkOcultarDrivers_Changed"/>
                <CheckBox x:Name="ChkOcultarMicrosoft" Content="Ocultar Microsoft" Margin="0,0,8,8" VerticalAlignment="Center" Foreground="{StaticResource TextoPrimario}" Checked="ChkOcultarMicrosoft_Changed" Unchecked="ChkOcultarMicrosoft_Changed"/>
                <Button x:Name="BtnImportarLista" Content="📄 Importar lista" Margin="0,0,8,8" Padding="10,6" Style="{StaticResource BotaoPequeno}" Click="BtnImportarLista_Click"/>
            </WrapPanel>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#0b1220" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtFiltroProgramas" Grid.Column="0" Margin="0,0,10,0" ToolTip="Filtrar por nome" TextChanged="TxtFiltroProgramas_TextChanged" Padding="8,6"/>
                        <TextBlock Grid.Column="1" x:Name="TxtContadorProgramas" Text="0 programas selecionados" Foreground="#E2E8F0" VerticalAlignment="Center" FontSize="12"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Programas instalados" Style="{StaticResource TituloCard}" Margin="0,0,0,10"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ListaProgramasRelatorio">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="CardPrograma" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="10" Background="#111827" Padding="10" Margin="0,0,8,8" Width="250" Tag="{Binding}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Desinstalar programa" Click="DesinstalarPrograma_Click" CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#111827"/>
                                                    <Setter Property="BorderBrush" Value="#334155"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IncluirNoRelatorio}" Value="True">
                                                            <Setter Property="Background" Value="#1E3A8A"/>
                                                            <Setter Property="BorderBrush" Value="#60A5FA"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <CheckBox IsChecked="{Binding IncluirNoRelatorio, Mode=TwoWay}" VerticalAlignment="Top" Checked="CheckBox_Checked" Unchecked="CheckBox_Checked">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Nome}" Foreground="#F8FAFC" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Fabricante}" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                            <TextBlock Foreground="#94A3B8" TextWrapping="Wrap">
                                                                <Run Text="v"/><Run Text="{Binding Versao}"/>
                                                            </TextBlock>
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="#0b1220" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Programas que irão para o relatório" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ListBox x:Name="ListaProgramasSelecionados" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="6,4" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Nome}" Foreground="#E2E8F0" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
