<UserControl x:Class="SystemWM.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="Relatórios" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextoPrimario}"/>
            <TextBlock Text="Gere e envie o relatório da visita técnica por e-mail" Style="{StaticResource LabelSecundario}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="700">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Seções do relatório" Style="{StaticResource TituloCard}" Margin="0,0,0,10"/>
                        <TextBlock Text="Escolha quais áreas serão incluídas antes de gerar o relatório." Foreground="#F8FAFC" FontSize="13" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Border Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,10,8">
                                <CheckBox x:Name="ChkRelatorioResumoDashboard" Content="Resumo do Dashboard" Foreground="#F8FAFC" FontWeight="SemiBold" IsChecked="True" Checked="ChkRelatorio_Changed" Unchecked="ChkRelatorio_Changed"/>
                            </Border>
                            <Border Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,10,8">
                                <CheckBox x:Name="ChkRelatorioHardware" Content="Hardware" Foreground="#F8FAFC" FontWeight="SemiBold" Checked="ChkRelatorio_Changed" Unchecked="ChkRelatorio_Changed"/>
                            </Border>
                            <Border Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,10,8">
                                <CheckBox x:Name="ChkRelatorioFirewall" Content="Firewall" Foreground="#F8FAFC" FontWeight="SemiBold" Checked="ChkRelatorio_Changed" Unchecked="ChkRelatorio_Changed"/>
                            </Border>
                            <Border Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <CheckBox x:Name="ChkRelatorioLimpeza" Content="Limpeza" Foreground="#F8FAFC" FontWeight="SemiBold" Checked="ChkRelatorio_Changed" Unchecked="ChkRelatorio_Changed"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="Tipo de relatório:" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbTipoRelatorio" Width="160" SelectedIndex="0">
                                <ComboBoxItem Content="TXT" Tag="txt"/>
                                <ComboBoxItem Content="HTML" Tag="html"/>
                                <!-- PDF removed -->
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnGerar" Content="📄 Gerar relatório" Style="{StaticResource BotaoSecundario}" Margin="0,0,10,0" Click="BtnGerar_Click"/>
                            <Button x:Name="BtnEnviar" Content="✉ Enviar por e-mail" Style="{StaticResource BotaoPrimario}" Click="BtnEnviar_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#0F172A" BorderBrush="#5B8DEF" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
                    <TextBlock x:Name="TxtStatus" Foreground="#F8FAFC" TextWrapping="Wrap" FontWeight="SemiBold"/>
                </Border>

                <Border Style="{StaticResource CardStyle}" Background="#111827" BorderBrush="#5B8DEF" BorderThickness="1.2" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="1.95*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="Programas para o relatório" Style="{StaticResource TituloCard}" Margin="0,0,0,10"/>
                            <TextBlock Text="Selecione os programas que devem aparecer na seção de programas do relatório." Foreground="#F8FAFC" FontSize="13" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <ListBox x:Name="ListaProgramasRelatorioSelecao" MinHeight="220" MaxHeight="320" Background="#0B1220" BorderBrush="#5B8DEF" BorderThickness="1.2" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Nome}" IsChecked="{Binding IncluirNoRelatorio, Mode=TwoWay}" Foreground="#F8FAFC" Margin="0,2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#0B1220" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Conteúdo do relatório em texto legível" Style="{StaticResource TituloCard}" Margin="0,0,0,10"/>
                                <TextBox x:Name="TxtRelatorioPreview" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent" Foreground="#f8fafc" FontFamily="Segoe UI" FontSize="13" BorderThickness="0" Padding="0"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
